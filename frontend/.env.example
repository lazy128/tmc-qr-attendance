VITE_EDGE_API_URL=http://127.0.0.1:8084
# For the two-site workflow demo, set VITE_EDGE_API_URL=http://127.0.0.1:8090 and uncomment:
# VITE_EDGES=[{"site":"SITE-BD","station":"BD-G01","url":"http://localhost:8081"},{"site":"SITE-LA","station":"LA-G01","url":"http://localhost:8082"}]
# To serve a loopback Edge over the same origin as the HTTPS Vite dev server:
# VITE_EDGE_API_URL=/edge-api
# TMC_DEV_PROXY_TARGET=http://127.0.0.1:8084
# Set this when /employee is opened on localhost and a phone needs to open the QR link.
# VITE_QR_SCAN_ORIGIN=http://192.168.1.25:5173
# TMC_DEV_HTTPS_CERT=absolute/path/to/dev-cert.pem
# TMC_DEV_HTTPS_KEY=absolute/path/to/dev-key.pem
